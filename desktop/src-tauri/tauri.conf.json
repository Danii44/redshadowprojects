{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Red Shadow Projects",
  "version": "0.1.0",
  "identifier": "com.redshadowdesigns.projects",
  "build": {
    "frontendDist": "../../desktop-shell",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "npm run dev -- --hostname 127.0.0.1"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Red Shadow Projects",
        "url": "index.html",
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "capabilities": [
        "main-capability",
        "local-development"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
