{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Allow only the trusted Red Shadow Projects web app to use native notifications.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://redshadowprojects.vercel.app/**"
    ]
  },
  "local": false,
  "permissions": [
    "notification:default"
  ]
}
